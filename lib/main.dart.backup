class LessonPage extends StatefulWidget {
  const LessonPage({
    super.key,
    required this.course,
    required this.saved,
    required this.downloaded,
  });

  final Course course;
  final bool saved;
  final bool downloaded;

  @override
  State<LessonPage> createState() => _LessonPageState();
}

class _LessonPageState extends State<LessonPage> {
  late bool _saved;
  late bool _downloaded;
  late bool _isLoading;

  @override
  void initState() {
    super.initState();
    _saved = widget.saved;
    _downloaded = widget.downloaded;
    _isLoading = true;
  }

  void _close({bool completed = false}) {
    Navigator.pop(
      context,
      LessonResult(
        completed: completed,
        saved: _saved,
        downloaded: _downloaded,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    if (_isLoading) {
      return const Scaffold(
        body: Center(child: CircularProgressIndicator()),
      );
    }
    
    return Scaffold(
      appBar: AppBar(
        leading: IconButton(
          onPressed: _close,
          icon: const Icon(Icons.arrow_back),
        ),
        title: Text(widget.course.title),
        actions: [
          IconButton(
            onPressed: () => setState(() => _saved = !_saved),
            icon: Icon(_saved ? Icons.bookmark : Icons.bookmark_outline),
            tooltip: _saved ? 'Remove saved lesson' : 'Save lesson',
          ),
          IconButton(
            onPressed: () => setState(() => _downloaded = !_downloaded),
            icon: Icon(
              _downloaded ? Icons.offline_pin_rounded : Icons.download_outlined,
            ),
            tooltip: _downloaded ? 'Remove download' : 'Make available offline',
          ),
        ],
      ),
      body: Column(
        children: [
          LinearProgressIndicator(
            value: .42, // This should come from actual progress tracking
            minHeight: 5,
            color: AppColors.aquaBlue,
            backgroundColor: AppColors.grey200,
          ),
          Expanded(
            child: ListView(
              padding: const EdgeInsets.fromLTRB(20, 26, 20, 20),
              children: [
                const Text(
                  'LESSON 1 OF ${widget.course.lessonCount}',
                  style: TextStyle(
                    fontSize: 12,
                    fontWeight: FontWeight.w800,
                    color: AppColors.aquaBlueDark,
                    letterSpacing: 1.1,
                  ),
                ),
                const SizedBox(height: 12),
                Text(
                  widget.course.title,
                  style: Theme.of(context).textTheme.headlineMedium?.copyWith(
                    fontWeight: FontWeight.w800,
                  ),
                ),
                const SizedBox(height: 10),
                Text(
                  'Welcome to ${widget.course.title}! Let\'s get started with the fundamentals.',
                  style: TextStyle(color: AppColors.grey600, height: 1.5),
                ),
                const SizedBox(height: 24),
                const _KeyIdea(
                  text:
                      'Think of the flex container as a parent that controls how its children line up.',
                ),
                const SizedBox(height: 24),
                Text(
                  'The two axes',
                  style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w800),
                ),
                const SizedBox(height: 9),
                const Text(
                  'Flexbox works with a main axis and a cross axis. By default, the main axis runs horizontally, from left to right. You can change that direction with flex-direction.',
                ),
                const SizedBox(height: 18),
                Container(
                  padding: const EdgeInsets.all(16),
                  decoration: BoxDecoration(
                    color: const Color(0xFF17212B),
                    borderRadius: BorderRadius.circular(14),
                  ),
                  child: const Text(
                    '.container {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}',
                    style: TextStyle(
                      fontFamily: 'monospace',
                      fontSize: 13,
                      color: Color(0xFFC7F9CC),
                      height: 1.6,
                    ),
                  ),
                ),
                const SizedBox(height: 22),
                Text(
                  'Try it yourself',
                  style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w800),
                ),
                const SizedBox(height: 8),
                const Text(
                  'Before you continue, predict what happens when justify-content is set to space-between.',
                ),
              ],
            ),
          ),
          SafeArea(
            top: false,
            child: Padding(
              padding: const EdgeInsets.fromLTRB(20, 10, 20, 16),
              child: SizedBox(
                width: double.infinity,
                child: ElevatedButton.icon(
                  onPressed: () => _close(completed: true),
                  icon: const Icon(Icons.check_circle_outline),
                  label: const Text('Mark as complete'),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

