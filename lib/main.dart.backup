class CourseTile extends StatelessWidget {
  const CourseTile({super.key, required this.course});
  final Course course;

  @override
  Widget build(BuildContext context) => Card(
    child: InkWell(
      borderRadius: BorderRadius.circular(16),
      onTap: () => Navigator.of(context).push(
        MaterialPageRoute(builder: (_) => CourseDetailPage(course: course)),
      ),
      child: Padding(
        padding: const EdgeInsets.all(14),
        child: Row(
          children: [
            Container(
              width: 54,
              height: 54,
              decoration: BoxDecoration(
                color: course.category.color.withValues(alpha: .13),
                borderRadius: BorderRadius.circular(14),
              ),
              child: Icon(course.category.icon, color: course.category.color, size: 27),
            ),
            const SizedBox(width: 13),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    course.title,
                    style: const TextStyle(
                      fontWeight: FontWeight.w800,
                      fontSize: 16,
                    ),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    '${course.lessonCount} lessons · ${course.estimatedHours}h',
                    style: const TextStyle(
                      color: AppColors.grey600,
                      fontSize: 12,
                    ),
                  ),
                  const SizedBox(height: 8),
                  Text(
                    course.category.title.toUpperCase(),
                    style: TextService(
                      color: course.category.color,
                      fontSize: 10,
                      fontWeight: FontWeight.w800,
                      letterSpacing: .7,
                    ),
                  ),
                ],
              ),
            ),
            const Icon(Icons.chevron_right, color: AppColors.grey500),
          ],
        ),
      ),
    ),
  );
}

class CourseDetailPage extends StatefulWidget {
  const CourseDetailPage({super.key, required this.course});
  final Course course;

  @override
  State<CourseDetailPage> createState() => _CourseDetailPageState();
}

class _CourseDetailPageState extends State<CourseDetailPage> {
  late bool _enrolled;

  @override
  void initState() {
    super.initState();
    _enrolled = StorageService.getBool('course_${widget.course.id}_enrolled', defaultValue: false);
  }

  Future<void> _toggleEnrollment() async {
    setState(() => _enrolled = !_enrolled);
    await StorageService.setBool('course_${widget.course.id}_enrolled', _enrolled);
    if (mounted) {
      _toast(
        context,
        _enrolled ? 'Added to My Learning' : 'Removed from My Learning',
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text(widget.course.title)),
      body: ListView(
        padding: const EdgeInsets.fromLTRB(20, 12, 20, 28),
        children: [
          Container(
            height: 150,
            padding: const EdgeInsets.all(20),
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: [
                  widget.course.category.color,
                  widget.course.category.color.withValues(alpha: .7),
                ],
              ),
              borderRadius: BorderRadius.circular(20),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Icon(widget.course.category.icon, color: Colors.white, size: 34),
                const Spacer(),
                Text(
                  widget.course.category.title.toUpperCase(),
                  style: TextService(
                    color: Colors.white.withValues(alpha: .8),
                    fontSize: 11,
                    fontWeight: FontWeight.w800,
                    letterSpacing: 1,
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  widget.course.title,
                  style: const TextService(
                    color: Colors.white,
                    fontSize: 23,
                    fontWeight: FontWeight.w800,
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 22),
          Text(
            widget.course.longDescription,
            style: Theme.of(context).textTheme.bodyLarge?.copyWith(color: AppColors.grey700),
          ),
          const SizedBox(height: 18),
          Row(
            children: [
              const Icon(
                Icons.menu_book_outlined,
                size: 18,
                color: AppColors.grey600,
              ),
              const SizedBox(width: 6),
              Text('${widget.course.lessonCount} lessons'),
              const SizedBox(width: 18),
              const Icon(
                Icons.schedule_outlined,
                size: 18,
                color: AppColors.grey600,
              ),
              const SizedBox(width: 6),
              Text('${widget.course.estimatedHours}h'),
            ],
          ),
          const SizedBox(height: 24),
          SizedBox(
            width: double.infinity,
            child: ElevatedButton.icon(
              onPressed: _toggleEnrollment,
              icon: Icon(
                _enrolled ? Icons.check_circle : Icons.add_circle_outline,
              ),
              label: Text(
                _enrolled ? 'Added to My Learning' : 'Removed from My Learning',
              ),
            ),
          ),
          const SizedBox(height: 26),
          Text(
            'What you’ll learn',
            style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w800),
          ),
          const SizedBox(height: 10),
          ...widget.course.learningOutcomes.map(
            (item) => Padding(
              padding: const EdgeInsets.only(bottom: 9),
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Icon(
                    Icons.check_circle_rounded,
                    color: widget.course.category.color,
                    size: 19,
                  ),
                  const SizedBox(width: 9),
                  Expanded(child: Text(item)),
                ],
              ),
            ),
          ),
          const SizedBox(height: 22),
          Text(
            'Course outline',
            style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w800),
          ),
          const SizedBox(height: 8),
          ...List.generate(
            5, // Placeholder for modules
            (index) => ListTile(
              contentPadding: EdgeInsets.zero,
              leading: CircleAvatar(
                radius: 15,
                backgroundColor: widget.course.category.color.withValues(alpha: .12),
                child: Text(
                  '${index + 1}',
                  style: TextService(
                    color: widget.course.category.color,
                    fontWeight: FontWeight.w800,
                    fontSize: 12,
                  ),
                ),
              ),
              title: Text(
                'Module ${index + 1}: Introduction',
                style: const TextService(fontWeight: FontWeight.w600),
              ),
              trailing: index == 0
                  ? const Icon(Icons.play_circle_outline)
                  : const Icon(
                      Icons.lock_outline,
                      size: 18,
                      color: AppColors.grey500,
                    ),
            ),
          ),
        ],
      ),
    );
  }
}

