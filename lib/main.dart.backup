                const SizedBox(width: 18),
                Icon(
                  Icons.favorite_border,
                  size: 18,
                  color: AppColors.grey600,
                ),
                const SizedBox(width: 5),
                Text(post.viewCount.toString(), style: const TextStyle(color: AppColors.grey600)),
                if (!post.isLocked) ...[
                  const SizedBox(width: 18),
                  IconButton(
                    icon: const Icon(Icons.flag_outlined, size: 18),
                    color: AppColors.grey600,
                    onPressed: () {
                      // TODO: Implement reporting
                      _toast(context, 'Reporting not implemented yet');
                    },
                  ),
                ],
              ],
            ),
          ],
        ),
      ),
    );
  }

  String _timeAgo(DateTime date) {
    final difference = DateTime.now().difference(date);
    if (difference.inDays > 0) {
      return '${difference.inDays}d ago';
    } else if (difference.inHours > 0) {
      return '${difference.inHours}h ago';
    } else if (difference.inMinutes > 0) {
      return '${difference.inMinutes}min ago';
    } else {
      return 'Just now';
    }
  }
}

class ProfilePage extends StatelessWidget {
  const ProfilePage({
    super.key,
    required this.xp,
  });

  final int xp;

  @override
  Widget build(BuildContext context) => FutureBuilder<UserProfile>(
    future: _getProfile(),
    builder: (context, snapshot) {
      if (snapshot.connectionState == ConnectionState.waiting) {
        return const Center(child: CircularProgressIndicator());
      }
      
      if (snapshot.hasError) {
        return Center(child: Text('Error loading profile: ${snapshot.error}'));
      }
      
      final profile = snapshot.data ?? _getDefaultProfile();
      
      // Compute initials from displayName
      final displayName = profile.displayName.isNotEmpty 
          ? profile.displayName 
          : 'Alex Rivera';
      final initials = displayName
          .split(' ')
          .map((part) => part[0])
          .take(2)
          .join('')
          .toUpperCase();
      
      return ListView(
        padding: const EdgeInsets.fromLTRB(20, 24, 20, 30),
        children: [
          Row(
            children: [
              CircleAvatar(
                radius: 31,
                backgroundColor: AppColors.coralRedSoft,
                child: Text(
                  initials,
                  style: TextStyle(
                    color: AppColors.coralRedDark,
                    fontSize: 24,
                    fontWeight: FontWeight.w800,
                  ),
                ),
              ),
              const SizedBox(width: 15),
              Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    profile.displayName,
                    style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w800),
                  ),
                  const SizedBox(height: 3),
                  Text(
                    profile.bio.isNotEmpty ? profile.bio : 'Aspiring Frontend Developer',
                    style: TextStyle(color: AppColors.grey600),
                  ),
                ],
              ),
              const Spacer(),
              IconButton(
                onPressed: () => _toast(context, 'Settings coming soon'),
                icon: const Icon(Icons.settings_outlined),
              ),
            ],
          ),
          const SizedBox(height: 25),
          _ProfileStats(profile: profile),
          const SizedBox(height: 28),
          Text(
            'This week',
            style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w800),
          ),
          const SizedBox(height: 14),
          const WeekActivity(),
          const SizedBox(height: 28),
          Text(
            'Achievements',
            style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w800),
          ),
          const SizedBox(height: 14),
          const Row(
            children: [
              Expanded(
                child: UserModels.Achievement(
                  id: 'streak_7',
                  title: 'On fire',
                  description: '7 day streak',
                  iconAsset: 'local_fire_department',
                  type: AchievementType.streakDays,
                  xpReward: 50,
                  isUnlocked: true,
                  progress: 7,
                  target: 7,
                ),
              ),
              SizedBox(width: 10),
              Expanded(
                child: UserModels.Achievement(
                  id: 'first_course',
                  title: 'Starter',
                  description: 'First path',
                  iconAsset: 'rocket_launch',
                  type: AchievementType.coursesCompleted,
                  xpReward: 100,
                  isUnlocked: true,
                  progress: 1,
                  target: 1,
                ),
              ),
              SizedBox(width: 10),
              Expanded(
                child: UserModels.Achievement(
                  id: 'streak_7',
                  title: 'On fire',
                  description: '7 day streak',
                  iconAsset: 'local_fire_department',
                  type: AchievementType.streakDays,
                  xpReward: 50,
                  isUnlocked: true,
                  progress: 7,
                  target: 7,
                ),
              ),
            ],
          ),
          const SizedBox(height: 28),
          _MenuRow(
            icon: Icons.bookmark_outline,
            title: '${profile.bookmarkedLessonIds.length} Saved lessons',
            onTap: () => _toast(context, 'Saved lessons feature coming soon'),
          ),
          _MenuRow(
            icon: Icons.download_outlined,
            title: '0 Downloads', // Placeholder since we removed downloadedContentIds
            onTap: () => _toast(context, 'Downloads feature coming soon'),
          ),
          _MenuRow(icon: Icons.help_outline, title: 'Help & support', onTap: () {}),
        ],
      );
    },
  );

  Future<UserProfile> _getProfile() async {
    final profile = StorageService.getUserProfile();
    if (profile != null) {
      return profile;
    }
    
    // Create default profile if none exists
    final defaultProfile = _getDefaultProfile();
    await StorageService.saveUserProfile(defaultProfile);
    return defaultProfile;
  }

  UserProfile _getDefaultProfile() {
    final displayName = 'Alex Rivera';
    final initials = displayName
        .split(' ')
        .map((part) => part[0])
        .take(2)
        .join('')
        .toUpperCase();
    
    final userLevel = UserLevel.getLevelForXp(xp);
    return UserProfile(
      id: 'current_user',
      email: 'alex@example.com',
      displayName: displayName,
      bio: 'Aspiring Frontend Developer',
      level: userLevel,
      xp: xp,
      totalXp: xp,
      completedCourseIds: [],
      enrolledCourseIds: ['frontend-foundations'], // For demo
      bookmarkedLessonIds: [],
      achievements: [
        UserModels.Achievement(
          id: 'streak_7',
          title: 'On fire',
          description: '7 day streak',
          iconAsset: 'local_fire_department',
          type: AchievementType.streakDays,
          xpReward: 50,
          isUnlocked: true,
          progress: 7,
          target: 7,
        ),
        UserModels.Achievement(
          id: 'first_course',
          title: 'Starter',
          description: 'First path',
          iconAsset: 'rocket_launch',
          type: AchievementType.coursesCompleted,
          xpReward: 100,
          isUnlocked: true,
          progress: 1,
          target: 1,
        ),
      ],
      stats: UserModels.UserStats(
        totalCoursesCompleted: 1,
        totalLessonsCompleted: 5,
        totalQuizzesPassed: 2,
        totalProjectsCompleted: 0,
        totalStudyMinutes: 150,
        currentStreakDays: 7,
        longestStreakDays: 7,
        categoryProgress: {
          LearningCategory.webDevelopment: 1,
        },
        difficultyBreakdown: {
          DifficultyLevel.beginner: 1,
        },
      ),
      preferences: UserModels.UserPreferences(),
      joinedAt: DateTime.now().subtract(const Duration(days: 30)),
      lastActiveAt: DateTime.now(),
    );
  }
}

