void _toast(BuildContext context, String text) =>
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(text)));

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await StorageService.init();
  await CourseRepository.initializeSampleCourses();
  runApp(const BrainBoxApp());
}

class BrainBoxApp extends StatelessWidget {
  const BrainBoxApp({super.key});

  @override
  Widget build(BuildContext context) => MaterialApp(
        title: 'BrainBox',
        debugShowCheckedModeBanner: false,
        theme: AppTheme.lightTheme,
        home: const BrainBoxShell(),
      );
}

class BrainBoxShell extends StatefulWidget {
  const BrainBoxShell({super.key});
  @override
  State<BrainBoxShell> createState() => _BrainBoxShellState();
}

class _BrainBoxShellState extends State<BrainBoxShell> {
  int _tab = 0;
  bool _lessonComplete = false;
  bool _challengeComplete = false;
  int _xp = 0;
  bool _isLoading = true;

  @override
  void initState() {
    super.initState();
    _loadInitialState();
  }

  Future<void> _loadInitialState() async {
    final lessonComplete = StorageService.getBool('frontend_lesson_complete', defaultValue: false);
    final challengeComplete = StorageService.getBool('daily_challenge_complete', defaultValue: false);
    final xp = StorageService.getInt('learner_xp', defaultValue: 0);
    
    setState(() {
      _lessonComplete = lessonComplete;
      _challengeComplete = challengeComplete;
      _xp = xp;
      _isLoading = false;
    });
  }

  Future<void> _openLesson() async {
    // Find the frontend foundations course
    final courses = await CourseRepository.getAllCourses();
    final frontendCourse = courses.firstWhere(
      (course) => course.id == 'frontend-foundations',
      orElse: () => courses.first,
    );

    final result = await Navigator.of(context).push<LessonResult>(
      MaterialPageRoute(
        builder: (_) => LessonPage(
          course: frontendCourse,
          saved: false,  // Will be loaded from storage in LessonPage
          downloaded: false, // Will be loaded from storage in LessonPage
        ),
      ),
    );
    
    if (result == null) return;
    
    final earnedXp = result.completed && !_lessonComplete ? 25 : 0;
    setState(() {
      _lessonComplete = _lessonComplete || result.completed;
      _xp += earnedXp;
    });
    
    await StorageService.setBool('frontend_lesson_complete', _lessonComplete);
    await StorageService.setInt('learner_xp', _xp);
  }

  Future<void> _openChallenge() async {
    if (_challengeComplete) return;
    
    final score = await Navigator.of(
      context,
    ).push<int>(MaterialPageRoute(builder: (_) => const DailyChallengePage()));
    
    if (score == null) return;
    
    setState(() {
      _challengeComplete = true;
      _xp += 50;
    });
    
    await StorageService.setBool('daily_challenge_complete', true);
    await StorageService.setInt('learner_xp', _xp);
  }

  @override
  Widget build(BuildContext context) {
    if (_isLoading) {
      return const Center(child: CircularProgressIndicator());
    }
    
    final pages = [
      HomePage(
        onOpenLesson: _openLesson,
        onOpenChallenge: _openChallenge,
        lessonComplete: _lessonComplete,
        challengeComplete: _challengeComplete,
        xp: _xp,
      ),
      const ExplorePage(),
      LearningPage(lessonComplete: _lessonComplete, xp: _xp),
      const CommunityPage(),
      ProfilePage(xp: _xp),
    ];
    
    return Scaffold(
      body: SafeArea(
        child: IndexedStack(index: _tab, children: pages),
      ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: _tab,
        onDestinationSelected: (index) => setState(() => _tab = index),
        height: 72,
        indicatorColor: AppColors.aquaBlueSoft,
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(Icons.home),
            label: 'Home',
          ),
          NavigationDestination(
            icon: Icon(Icons.explore_outlined),
            selectedIcon: Icon(Icons.explore),
            label: 'Explore',
          ),
          NavigationDestination(
            icon: Icon(Icons.school_outlined),
            selectedIcon: Icon(Icons.school),
            label: 'Learning',
          ),
          NavigationDestination(
            icon: Icon(Icons.forum_outlined),
            selectedIcon: Icon(Icons.forum),
            label: 'Community',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline),
            selectedIcon: Icon(Icons.person),
            label: 'Profile',
          ),
        ],
      ),
    );
  }
}

