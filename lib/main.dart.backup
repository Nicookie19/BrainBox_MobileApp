class DailyChallengePage extends StatefulWidget {
  const DailyChallengePage({super.key});

  @override
  State<DailyChallengePage> createState() => _DailyChallengePageState();
}

class _DailyChallengePageState extends State<DailyChallengePage> {
  static const _questions = [
    _QuizQuestion('What does Array.map() return?', [
      'A single value',
      'A new array',
      'Nothing',
      'A string',
    ], 1),
    _QuizQuestion('Which keyword creates a constant in JavaScript?', [
      'var',
      'let',
      'const',
      'static',
    ], 2),
    _QuizQuestion('What is the result of 2 + "2" in JavaScript?', [
      '4',
      '22',
      'Error',
      'null',
    ], 1),
  ];
  int _index = 0;
  int _score = 0;
  int? _selected;
  bool _answered = false;

  void _answer(int index) {
    if (_answered) return;
    setState(() {
      _selected = index;
      _answered = true;
      if (index == _questions[_index].answer) _score++;
    });
  }

  void _next() {
    if (_index == _questions.length - 1) {
      Navigator.pop(context, _score);
      return;
    }
    setState(() {
      _index++;
      _selected = null;
      _answered = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    final question = _questions[_index];
    return Scaffold(
      appBar: AppBar(title: const Text('Daily challenge')),
      body: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                const Icon(Icons.bolt_rounded, color: AppColors.coralRed),
                const SizedBox(width: 8),
                Text(
                  '50 XP available',
                  style: Theme.of(context).textTheme.titleMedium?.copyWith(
                    color: AppColors.coralRedDark,
                    fontWeight: FontWeight.w800,
                  ),
                ),
                const Spacer(),
                Text(
                  '${_index + 1}/3',
                  style: const TextStyle(color: AppColors.grey600),
                ),
              ],
            ),
            const SizedBox(height: 14),
            LinearProgressIndicator(
              value: (_index + 1) / _questions.length,
              minHeight: 7,
              color: AppColors.coralRed,
              backgroundColor: AppColors.coralRedSoft,
            ),
            const SizedBox(height: 34),
            Text(
              question.text,
              style: Theme.of(context).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w800),
            ),
            const SizedBox(height: 24),
            ...List.generate(question.options.length, (index) {
              final correct = index == question.answer;
              final selected = index == _selected;
              final color = _answered
                  ? (correct
                        ? AppColors.success
                        : selected
                        ? AppColors.coralRed
                        : AppColors.grey300)
                  : AppColors.grey300;
              return Padding(
                padding: const EdgeInsets.only(bottom: 12),
                child: OutlinedButton(
                  onPressed: () => _answer(index),
                  style: OutlinedButton.styleFrom(
                    alignment: Alignment.centerLeft,
                    foregroundColor: AppColors.grey900,
                    side: BorderSide(
                      color: color,
                      width: selected || (_answered && correct) ? 2 : 1,
                    ),
                    backgroundColor: _answered && correct
                        ? const Color(0xFFE8F8EC)
                        : null,
                  ),
                  child: Padding(
                    padding: const EdgeInsets.symmetric(vertical: 4),
                    child: Text(question.options[index]),
                  ),
                ),
              );
            }),
            if (_answered)
              Container(
                width: double.infinity,
                margin: const EdgeInsets.only(top: 4),
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: AppColors.aquaBlueSoft,
                  borderRadius: BorderRadius.circular(12),
                ),
                child: Text(
                  _selected == question.answer
                      ? 'Correct — nice work!'
                      : 'Not quite. The correct answer is “${question.options[question.answer]}”.',
                  style: const TextStyle(
                    color: AppColors.aquaBlueDark,
                    fontWeight: FontWeight.w600,
                  ),
                ),
              ),
            const Spacer(),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: _answered ? _next : null,
                style: ElevatedButton.styleFrom(
                  backgroundColor: AppColors.coralRed,
                ),
                child: Text(
                  _index == _questions.length - 1
                      ? 'Finish challenge'
                      : 'Next question',
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _QuizQuestion {
  const _QuizQuestion(this.text, this.options, this.answer);
  final String text;
  final List<String> options;
  final int answer;
}

